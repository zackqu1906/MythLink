        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "该因素0–100子分；缺失null。"
        },
        "weight": {
          "type": "number",
          "description": "原始权重。"
        },
        "effectiveWeight": {
          "type": "number",
          "description": "可用项归一化权重，缺失为0。"
        },
        "inputValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "实际输入，单位见unit；温度只含偏差。"
