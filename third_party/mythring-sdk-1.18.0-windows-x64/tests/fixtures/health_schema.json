    "AutomaticSyncResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "description": "协议版本 2。"
        },
        "accountScope": {
          "type": "string",
          "description": "稳定账户标识，不传密码/token。"
        },
        "deviceAddress": {
          "type": "string",
          "description": "戒指设备地址，不是眼镜/手机地址。"
        },
        "timeZone": {
          "type": "string",
          "description": "汇总采用的 IANA 时区。"
        },
        "syncedAtUtcMs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "最近成功在线同步时间，未成功过可空，不是每条采样时间。"
        },
        "status": {
          "type": "string",
          "description": "SUCCESS、PARTIAL、CACHE_ONLY、FAILED；独立离线示例为DEMO；同步成功不代表有数据。"
        },
        "liveHeartSupported": {
          "type": "boolean",
          "description": "是否支持实时心率；不表示已有心率值。"
        },
        "deviceState": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthState"
            },
            {
              "type": "null"
            }
          ],
          "description": "设备状态，未取得时 null。"
        },
        "sync": {
          "$ref": "#/$defs/SyncSummary",
          "description": "本轮同步摘要。"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicHealthReport"
          },
          "description": "公开报告快照，不能与 daily 再相加。"
        },
        "vitalHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VitalHistoryValue"
          },
          "description": "有效自动测量历史，JSON 展平 measurement。"
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DailyHealthSummary"
          },
          "description": "本地自然日统计。"
        },
        "lossRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthLossRange"
          },
          "description": "设备报告的缺失记录范围。"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SyncError"
          },
          "description": "本次结构化错误；成功可为空数组。"
        },
        "temperature": {
          "$ref": "#/$defs/HealthTemperatureResult",
          "description": "1.11.0 新增；无温度也应输出包含空数组的对象。"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthPageSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "SDK 页面汇总。syncAutomatic 返回已汇总对象；手动构建 DTO 未调用 withPageSummary 时可空。"
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthCapabilities"
            },
            {
              "type": "null"
            }
          ],
          "description": "本客户端当前连接已读取的能力快照；断连清除，离线新客户端为 null，不从历史记录伪造。"
        }
      },
      "required": [
        "schemaVersion",
        "accountScope",
        "deviceAddress",
        "timeZone",
        "syncedAtUtcMs",
        "status",
        "liveHeartSupported",
        "deviceState",
        "sync",
        "reports",
        "vitalHistory",
        "daily",
        "lossRanges",
        "errors",
        "temperature",
        "page",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HealthScoreContributor": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "评分因素稳定key，见评分算法。"
