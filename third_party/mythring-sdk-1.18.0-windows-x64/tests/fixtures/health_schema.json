{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ring SDK 健康同步结果",
  "$ref": "#/$defs/AutomaticSyncResult",
  "$defs": {
    "HealthState": {
      "type": "object",
      "properties": {
        "recording": {
          "type": "boolean",
          "description": "是否正在写健康记录；不是正在测量心率的充分条件。"
        },
        "recordingId": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "设备记录 ID；recording=false 时不视为活动记录。"
        },
        "opticalMode": {
          "type": "integer",
          "description": "光学模式：0 关闭、1 绿光、2 血氧，未知原码保留。"
        },
        "manual": {
          "type": "boolean",
          "description": "设备手动采集标志。"
        },
        "manualDone": {
          "type": "boolean",
          "description": "最近手动流程完成标志，可能保留；不等于测量成功。"
        },
        "deviceError": {
          "type": "integer",
          "description": "设备状态错误码，0 表示未报告错误。"
        },
        "monitoringState": {
          "type": "integer",
          "description": "0 未运行/暂停、1 日间、2 卧床候选、3 充电；不等于佩戴状态。"
        },
        "timeKnown": {
          "type": "boolean",
          "description": "设备是否已建立时间基准。"
        },
        "bootId": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "设备启动 ID，有符号十进制字符串，可以为负；不做 JS Number 运算。"
        },
        "uptimeMs": {
          "type": "integer",
          "description": "同一启动后的毫秒数。"
        }
      },
      "required": [
        "recording",
        "recordingId",
        "opticalMode",
        "manual",
        "manualDone",
        "deviceError",
        "monitoringState",
        "timeKnown",
        "bootId",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "SyncSummary": {
      "type": "object",
      "properties": {
        "receivedBytes": {
          "type": "integer",
          "description": "本轮接收字节，续传前缀不重复计。"
        },
        "totalBytes": {
          "type": "integer",
          "description": "本轮待传字节；不是档案/JSON 大小。"
        },
        "downloadedRecordCount": {
          "type": "integer",
          "description": "本轮新完成下载的记录数，缓存命中不计。"
        },
        "currentStepsUpdated": {
          "type": "boolean",
          "description": "本轮是否刷新临时步数，结果仍在 reports/daily 内。"
        },
        "deferredRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "description": "待下轮继续处理的记录 ID。"
        }
      },
      "required": [
        "receivedBytes",
        "totalBytes",
        "downloadedRecordCount",
        "currentStepsUpdated",
        "deferredRecordIds"
      ],
      "additionalProperties": false
    },
    "HealthRecording": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "记录 ID，JSON 字符串；不能单独作跨设备永久键。"
        },
        "status": {
          "type": "integer",
          "description": "0 正在写入、1 正常封存、2 中断封存、3 空间不足封存。"
        },
        "bytes": {
          "type": "integer",
          "description": "记录数据字节数。"
        },
        "startUtcMs": {
          "type": "integer",
          "description": "记录起点 UTC 毫秒；描述符时间未知可为 0。"
        },
        "durationMs": {
          "type": "integer",
          "description": "记录跨度毫秒，含缺口，不等于睡眠时长。"
        },
        "mode": {
          "type": "integer",
          "description": "记录模式标识，按实际返回保留。"
        }
      },
      "required": [
        "id",
        "status",
        "bytes",
        "startUtcMs",
        "durationMs",
        "mode"
      ],
      "additionalProperties": false
    },
    "HealthValue": {
      "type": "object",
      "properties": {
        "timeUtcMs": {
          "type": "integer",
          "description": "采样 UTC 毫秒，不能用同步时间替代。"
        },
        "metric": {
          "type": "string",
          "description": "HEART_RATE/SPO2/HRV。"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "有限测量值；缺测/无效为 null，不补 0。"
        },
        "unit": {
          "type": "string",
          "description": "bpm/%/ms。"
        },
        "quality": {
          "type": "string",
          "description": "VALID、INSUFFICIENT_DATA、NON_WEAR、GAP、PROVISIONAL；未知值保留。"
        },
        "source": {
          "type": "string",
          "description": "FIRMWARE 或 ANDROID，表示计算来源。"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "原始置信信息；跨指标量纲未统一，不当成健康评分。"
        },
        "measurementId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "测量关联 ID，可空，不承诺跨重启全局唯一。"
        },
        "rejectionReason": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535,
          "description": "固件心率质量拒绝位图；0 为通过，null 为旧数据或非心率。候选值保留 PROVISIONAL，不进入合格测量统计。"
        }
      },
      "required": [
        "timeUtcMs",
        "metric",
        "value",
        "unit",
        "quality",
        "source",
        "confidence",
        "measurementId"
      ],
      "additionalProperties": false
    },
    "HealthActivity": {
      "type": "object",
      "properties": {
        "startUtcMs": {
          "type": "integer",
          "description": "活动窗口起点 UTC 毫秒。"
        },
        "durationMs": {
          "type": "integer",
          "description": "窗口时长毫秒，当前通常 20000。"
        },
        "candidateSteps": {
          "type": "integer",
          "description": "候选步数，不是最终计入值。"
        },
        "steps": {
          "type": "integer",
          "description": "最终窗口步数，结合 quality 判定有效零步；此字段本身不可空。"
        },
        "locomotionProbability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "有效窗口分类概率 0～1，缺失为 null。"
        },
        "quality": {
          "type": "string",
          "description": "有效与否；仅 VALID 参加步数汇总。"
        },
        "windowKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "活动窗口去重键；可能为空。"
        }
      },
      "required": [
        "startUtcMs",
        "durationMs",
        "candidateSteps",
        "steps",
        "locomotionProbability",
        "quality",
        "windowKey"
      ],
      "additionalProperties": false
    },
    "HealthBedtime": {
      "type": "object",
      "properties": {
        "startUtcMs": {
          "type": "integer",
          "description": "卧床起点 UTC 毫秒，不保证睡着。"
        },
        "endUtcMs": {
          "type": "integer",
          "description": "卧床终点 UTC 毫秒；区间左闭右开。"
        }
      },
      "required": [
        "startUtcMs",
        "endUtcMs"
      ],
      "additionalProperties": false
    },
    "HealthSleepEpoch": {
      "type": "object",
      "properties": {
        "startUtcMs": {
          "type": "integer",
          "description": "分期起点 UTC 毫秒。"
        },
        "durationMs": {
          "type": "integer",
          "description": "实际片段时长毫秒，不能假设固定 5 分钟。"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LIGHT 浅睡、DEEP 深睡、REM 快速眼动、AWAKE 清醒；null/未知留空。"
        },
        "estimated": {
          "type": "boolean",
          "description": "是否估计补齐；true 不计有效统计。"
        },
        "provisional": {
          "type": "boolean",
          "description": "是否暂定、待后续上下文确认。"
        },
        "quality": {
          "type": "string",
          "description": "质量枚举；有效统计需 VALID 且非 estimated/provisional。"
        }
      },
      "required": [
        "startUtcMs",
        "durationMs",
        "stage",
        "estimated",
        "provisional",
        "quality"
      ],
      "additionalProperties": false
    },
    "HealthWearEvent": {
      "type": "object",
      "properties": {
        "timeUtcMs": {
          "type": "integer",
          "description": "光学接触事件 UTC 毫秒。"
        },
        "state": {
          "type": "integer",
          "description": "0 未知、1 有接触、2 离腕；不同于 wearStates.state。"
        }
      },
      "required": [
        "timeUtcMs",
        "state"
      ],
      "additionalProperties": false
    },
    "HealthWearStateEvent": {
      "type": "object",
      "properties": {
        "timeUtcMs": {
          "type": "integer",
          "description": "佩戴状态事件 UTC 毫秒。"
        },
        "state": {
          "type": "integer",
          "description": "0 离腕、1 暂定佩戴、2 确认佩戴；不同于 wear.state。"
        },
        "retryLevel": {
          "type": "integer",
          "description": "设备重试等级原码 0～255；不是质量分。"
        }
      },
      "required": [
        "timeUtcMs",
        "state",
        "retryLevel"
      ],
      "additionalProperties": false
    },
    "PublicHealthReport": {
      "type": "object",
      "properties": {
        "recording": {
          "$ref": "#/$defs/HealthRecording",
          "description": "记录描述符。"
        },
        "algorithmVersion": {
          "type": "string",
          "description": "分析器版本，可随算法升级变化。"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthValue"
          },
          "description": "报告健康值，包含 HRV；应同时检查质量状态和空值。"
        },
        "activity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthActivity"
          },
          "description": "报告活动窗口。"
        },
        "bedtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthBedtime"
          },
          "description": "分段卧床。"
        },
        "sleep": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthSleepEpoch"
          },
          "description": "分段分期，不公开 probabilities。"
        },
        "wear": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthWearEvent"
          },
          "description": "光学接触事件。"
        },
        "wearStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthWearStateEvent"
          },
          "description": "确认/暂定/离腕状态事件。"
        },
        "wearStatesAvailable": {
          "type": "boolean",
          "description": "是否具备该项分析输出；true+[] 不表示未佩戴。"
        },
        "temperatureAvailable": {
          "type": "boolean",
          "description": "已由支持温度的分析器处理；不保证存在有效样本。"
        },
        "activityAvailable": {
          "type": "boolean",
          "description": "活动分析能力/上下文是否可用，不等于已有步数。"
        },
        "nightlyHrvAvailable": {
          "type": "boolean",
          "description": "报告夜间 HRV 分析能力标志；不代表已有夜间样本。"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "报告告警代码列表；可出现 FEATURE_GAP、BEDTIME_CONTEXT_PENDING 等，未知保留。"
        }
      },
      "required": [
        "recording",
        "algorithmVersion",
        "values",
        "activity",
        "bedtimes",
        "sleep",
        "wear",
        "wearStates",
        "wearStatesAvailable",
        "temperatureAvailable",
        "activityAvailable",
        "nightlyHrvAvailable",
        "warnings"
      ],
      "additionalProperties": false
    },
    "VitalHistoryValue": {
      "type": "object",
      "properties": {
        "timeUtcMs": {
          "type": "integer",
          "description": "采样 UTC 毫秒，不能用同步时间替代。"
        },
        "metric": {
          "type": "string",
          "description": "HEART_RATE/SPO2/HRV。"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "有限测量值；缺测/无效为 null，不补 0。"
        },
        "unit": {
          "type": "string",
          "description": "bpm/%/ms。"
        },
        "quality": {
          "type": "string",
          "description": "VALID、INSUFFICIENT_DATA、NON_WEAR、GAP、PROVISIONAL；未知值保留。"
        },
        "source": {
          "type": "string",
          "description": "FIRMWARE 或 ANDROID，表示计算来源。"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "原始置信信息；跨指标量纲未统一，不当成健康评分。"
        },
        "measurementId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "测量关联 ID，可空，不承诺跨重启全局唯一。"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "按请求时区得到的采样日期。"
        },
        "period": {
          "type": "string",
          "description": "day 或 night；night 只代表在卧床区间，不等于昨夜睡眠。"
        },
        "derivedFromRri": {
          "type": "boolean",
          "description": "是否由有效 RRI 推导心率或 RMSSD。"
        },
        "rejectionReason": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535,
          "description": "固件心率质量拒绝位图；0 为通过，null 为旧数据或非心率。候选值保留 PROVISIONAL，不进入合格测量统计。"
        }
      },
      "required": [
        "timeUtcMs",
        "metric",
        "value",
        "unit",
        "quality",
        "source",
        "confidence",
        "measurementId",
        "date",
        "period",
        "derivedFromRri"
      ],
      "additionalProperties": false
    },
    "DailyHealthSummary": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "本地自然日，不是完整一夜的归属日。"
        },
        "timeZone": {
          "type": "string",
          "description": "IANA 时区。"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "该自然日有效去重步数，无有效窗 null，有有效零步窗 0。"
        },
        "walkingSeconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "有效正步数窗口时长和/1000，不是全部运动秒数。"
        },
        "activityAvailable": {
          "type": "boolean",
          "description": "当天是否有活动能力覆盖或有效窗。"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthValue"
          },
          "description": "该自然日的测量序列，不是日均值，可能含无效点。"
        },
        "bedtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthBedtime"
          },
          "description": "按本地午夜裁剪的卧床片段。"
        },
        "sleep": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthSleepEpoch"
          },
          "description": "按卧床/午夜裁剪及去重的分期。"
        },
        "validSleepMinutes": {
          "type": "integer",
          "description": "有效 LIGHT/DEEP/REM 毫秒和最后向下取整分钟，不是昨夜总时长。"
        },
        "hasValidSleep": {
          "type": "boolean",
          "description": "是否至少有一段有效睡眠，少于一分钟时也可为 true。"
        }
      },
      "required": [
        "date",
        "timeZone",
        "steps",
        "walkingSeconds",
        "activityAvailable",
        "values",
        "bedtimes",
        "sleep",
        "validSleepMinutes",
        "hasValidSleep"
      ],
      "additionalProperties": false
    },
    "HealthLossRange": {
      "type": "object",
      "properties": {
        "firstSequence": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "缺失设备记录创建序号起点，闭区间。"
        },
        "lastSequence": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "缺失序号终点，闭区间。"
        },
        "compacted": {
          "type": "boolean",
          "description": "true 为合并过的历史范围，不逐项推断可恢复记录。"
        }
      },
      "required": [
        "firstSequence",
        "lastSequence",
        "compacted"
      ],
      "additionalProperties": false
    },
    "SyncError": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "description": "发生错误的阶段，如 TRANSFER、STATUS、ANALYZE。"
        },
        "recordingId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "description": "关联记录 ID，无单条关联时 null。"
        },
        "code": {
          "type": "string",
          "description": "当前 DEVICE_ERROR 或 SYNC_ERROR。"
        },
        "deviceCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "设备错误原码，如 -110；非设备异常通常 null。"
        },
        "message": {
          "type": "string",
          "description": "诊断文本，不作稳定业务枚举/直接 UI 文案。"
        }
      },
      "required": [
        "stage",
        "recordingId",
        "code",
        "deviceCode",
        "message"
      ],
      "additionalProperties": false
    },
    "HealthTemperaturePointJSON": {
      "type": "object",
      "properties": {
        "startUtcMs": {
          "type": "integer",
          "description": "区间起点UTC毫秒。"
        },
        "endUtcMs": {
          "type": "integer",
          "description": "区间终点UTC毫秒。"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "DAY自然日、NIGHT起床归属日。"
        },
        "deviationCelsius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "相对个人睡眠基线的偏差°C，可正负；null缺失。"
        },
        "validMinutes": {
          "type": "integer",
          "description": "有效分钟数。"
        },
        "sampleCount": {
          "type": "integer",
          "description": "有效采样数。"
        },
        "baselineNights": {
          "type": "integer",
          "description": "近7日可用夜数；短基线实际仅用最近一夜。"
        },
        "baselineSource": {
          "type": "string",
          "description": "NONE/INITIAL_SLEEP/LATEST_SLEEP/ROLLING_7_NIGHTS。"
        },
        "baselineId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "参考标识，无绝对温度明文。"
        },
        "status": {
          "type": "string",
          "description": "READY/BASELINE_BUILDING/INITIAL_BASELINE/NO_BASELINE/INSUFFICIENT_DATA/PARTIAL。"
        },
        "period": {
          "type": "string",
          "description": "DAY或NIGHT。"
        },
        "expectedMinutes": {
          "type": "integer",
