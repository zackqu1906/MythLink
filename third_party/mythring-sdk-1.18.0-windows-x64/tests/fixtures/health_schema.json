          "type": "boolean",
          "description": "mode=7 且自动能力位存在。"
        },
        "swipeDayConcurrent": {
          "type": "boolean",
          "description": "是否支持手势与日间健康同时工作。"
        },
        "swipeSleepConcurrent": {
          "type": "boolean",
          "description": "是否支持手势与睡眠监测同时工作。"
        },
        "retainedHistory": {
          "type": "boolean",
          "description": "是否支持历史保留；确认删除策略须单独查询。"
